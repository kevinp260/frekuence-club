{
  "name": "frekuence-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build && npm run validate:production",
    "build:fixtures": "FREKUENCE_EVENT_FIXTURES=true astro build --out-dir dist-fixtures",
    "preview": "node scripts/serve-dist.mjs",
    "preview:fixtures": "node scripts/serve-dist.mjs --root dist-fixtures",
    "assets:generate": "node scripts/generate-brand-derivatives.mjs",
    "check": "npm run format:check && npm run lint && astro check && npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "npm run build:fixtures && playwright test",
    "test:visual": "npm run build:fixtures && CAPTURE_VISUALS=true playwright test tests/browser/visual.spec.ts",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "audit:lighthouse:fixtures": "npm run build:fixtures && LIGHTHOUSE_ROOT=dist-fixtures LIGHTHOUSE_REPORT_PATH=lighthouse-fixtures-report.json LIGHTHOUSE_PORT=4323 node scripts/run-lighthouse.mjs",
    "validate:production": "node scripts/validate-production.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.34.0",
    "astro": "7.2.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "1.7.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
