---
interface Props {
  kicker: string;
  title: string;
  intro: string;
}

const { kicker, title, intro } = Astro.props;
---

<header class="page-intro section-shell">
  <p class="kicker">{kicker}</p>
  <div class="page-intro__grid">
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</header>

<style>
  .page-intro {
    min-height: clamp(27rem, 62vh, 48rem);
    padding-block: var(--space-5) var(--space-7);
    border-bottom: 1px solid var(--color-gray-dark);
  }

  .page-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.7fr);
    align-items: end;
    gap: var(--space-5);
    min-height: clamp(20rem, 48vh, 37rem);
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: var(--step-6);
    line-height: 0.82;
    letter-spacing: -0.075em;
    text-transform: uppercase;
  }

  .page-intro__grid > p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-pale-slate);
    font-size: var(--step-0);
  }

  @media (max-width: 47.99rem) {
    .page-intro {
      min-height: auto;
    }

    .page-intro__grid {
      grid-template-columns: 1fr;
      align-content: end;
      min-height: 28rem;
    }
  }
</style>
