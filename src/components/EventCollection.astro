---
import { getCollection } from 'astro:content';

import { isPastEvent, isPublishedEvent } from '../data/events';
import { t } from '../data/i18n';
import type { Locale } from '../data/routes';
import EventList from './EventList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const now = new Date();
const published = (await getCollection('events')).filter((event) => isPublishedEvent(event));
const upcoming = published
  .filter((event) => !isPastEvent(event, now))
  .sort((first, second) => first.data.startsAt.getTime() - second.data.startsAt.getTime());
const past = published
  .filter((event) => isPastEvent(event, now))
  .sort((first, second) => second.data.startsAt.getTime() - first.data.startsAt.getTime())
  .slice(0, 20);
---

<section class="event-collection" aria-label={copy.events.collectionLabel}>
  {
    published.length === 0 ? (
      <div class="event-empty" data-event-index-state="empty">
        <p class="event-empty__number" aria-hidden="true">
          00
        </p>
        <div class="event-empty__copy">
          <p class="event-empty__label">No signal / Europe–Tirane</p>
          <h2>{copy.events.emptyTitle}</h2>
          <p>{copy.events.emptyBody}</p>
          <p class="availability-status">{copy.common.reservationsStatus}</p>
        </div>
      </div>
    ) : (
      <div class="event-groups" data-event-index-state="published">
        <section class="event-group" aria-labelledby="upcoming-events-title">
          <h2 id="upcoming-events-title">{copy.events.upcomingLabel}</h2>
          {upcoming.length > 0 ? (
            <EventList locale={locale} events={upcoming} />
          ) : (
            <div class="event-group__empty">
              <p>{copy.events.emptyTitle}</p>
              <p>{copy.events.emptyBody}</p>
            </div>
          )}
        </section>
        {past.length > 0 && (
          <section class="event-group" aria-labelledby="past-events-title">
            <h2 id="past-events-title">{copy.events.pastLabel}</h2>
            <EventList locale={locale} events={past} />
          </section>
        )}
      </div>
    )
  }
</section>

<style>
  .event-empty {
    display: grid;
    grid-template-columns: minmax(11rem, 0.55fr) minmax(0, 1.45fr);
    min-height: clamp(24rem, 52vw, 42rem);
    border-block: 1px solid var(--color-gray-dark);
  }

  .event-empty__number {
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: var(--space-4);
    border-right: 1px solid var(--color-gray-dark);
    color: var(--color-gray);
    font-size: clamp(7rem, 18vw, 18rem);
    font-weight: 800;
    line-height: 0.72;
    letter-spacing: -0.1em;
  }

  .event-empty__copy {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-6) var(--page-gutter);
  }

  .event-empty__label {
    margin-block: 0 var(--space-5);
    color: var(--color-signal-red);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-empty h2 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--step-4);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .event-empty__copy > p:not(.event-empty__label, .availability-status) {
    max-width: 40rem;
    margin-block: var(--space-4) 0;
    color: var(--color-pale-slate);
  }

  .availability-status {
    margin-block: var(--space-5) 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-gray-dark);
    color: var(--color-soft-linen);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .event-groups {
    display: grid;
    gap: var(--space-7);
  }

  .event-group > h2 {
    margin-block: 0 var(--space-4);
    font-size: var(--step-3);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .event-group__empty {
    padding: var(--space-5);
    border: 1px solid var(--color-gray-dark);
  }

  .event-group__empty p {
    max-width: 42rem;
    margin: 0;
  }

  .event-group__empty p + p {
    margin-top: 0.75rem;
    color: var(--color-pale-slate);
  }

  @media (max-width: 47.99rem) {
    .event-empty {
      grid-template-columns: 1fr;
      min-height: 34rem;
    }

    .event-empty__number {
      min-height: 12rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-gray-dark);
      font-size: 8rem;
    }
  }
</style>
