---
import { Image } from 'astro:assets';

import type { EventEntry } from '../data/events';
import { eventRoute, formatEventDate, localizedEvent } from '../data/events';
import { t } from '../data/i18n';
import type { Locale } from '../data/routes';

interface Props {
  locale: Locale;
  events: EventEntry[];
  headingLevel?: 'h2' | 'h3';
}

const { locale, events, headingLevel = 'h3' } = Astro.props;
const copy = t(locale);
const EventHeading = headingLevel;
---

<ol class="event-list">
  {
    events.map((event, index) => {
      const content = localizedEvent(event, locale);

      return (
        <li class="event-card">
          <div class="event-card__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </div>
          <div class="event-card__poster">
            <Image
              src={event.data.poster}
              alt={content.posterAlt}
              widths={[360, 640, 900]}
              sizes="(max-width: 48rem) 100vw, 32vw"
              quality={65}
              loading="lazy"
            />
            {event.data.visualFixture && (
              <span class="event-card__fixture">{copy.home.fixtureNotice}</span>
            )}
          </div>
          <div class="event-card__content">
            <p class="event-card__status">{copy.events.statusLabels[event.data.status]}</p>
            <EventHeading>{content.title}</EventHeading>
            <time datetime={event.data.startsAt.toISOString()}>
              {formatEventDate(event.data.startsAt, locale)}
            </time>
            <p>{content.summary}</p>
            <p class="event-card__lineup">{event.data.lineup.join(' / ')}</p>
            <div class="event-card__actions">
              <a class="event-card__detail" href={eventRoute(event.data.slug, locale)}>
                {copy.common.viewEvent}
              </a>
              {event.data.ticketMode === 'door_only' && <span>{copy.home.doorContext}</span>}
              {!event.data.reservationsAvailable && <span>{copy.common.reservationsStatus}</span>}
            </div>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .event-list {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-gray-dark);
    list-style: none;
  }

  .event-card {
    display: grid;
    grid-template-columns: 7rem minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    border-bottom: 1px solid var(--color-gray-dark);
  }

  .event-card:last-child {
    border-bottom: 0;
  }

  .event-card__index,
  .event-card__content {
    padding: var(--space-4);
  }

  .event-card__index,
  .event-card__poster {
    border-right: 1px solid var(--color-gray-dark);
  }

  .event-card__index {
    color: var(--color-signal-red);
    font-weight: 700;
  }

  .event-card__poster {
    position: relative;
    min-height: 25rem;
  }

  .event-card__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-card__fixture {
    position: absolute;
    top: 1rem;
    left: 1rem;
    max-width: calc(100% - 2rem);
    padding: 0.45rem 0.6rem;
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--step--2);
    font-weight: 800;
    text-transform: uppercase;
  }

  .event-card__content {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
  }

  .event-card__status,
  .event-card__lineup {
    color: var(--color-signal-red);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
  }

  .event-card h2,
  .event-card h3 {
    margin-block: 0.5rem 1rem;
    font-size: var(--step-3);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .event-card time {
    color: var(--color-pale-slate);
  }

  .event-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--space-4);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
  }

  .event-card__actions > span,
  .event-card__actions > a {
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-gray-dark);
  }

  .event-card__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .event-card__detail {
    color: var(--color-white);
  }

  @media (max-width: 47.99rem) {
    .event-card {
      grid-template-columns: 4rem 1fr;
    }

    .event-card__poster,
    .event-card__content {
      grid-column: 2;
    }

    .event-card__poster {
      min-height: 0;
      border-bottom: 1px solid var(--color-gray-dark);
    }

    .event-card__content {
      padding-block: var(--space-5);
    }
  }
</style>
