---
import montserratUrl from '../assets/fonts/Montserrat-Variable-latin.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t } from '../data/i18n';
import { routeFor, type Locale, type PageKey } from '../data/routes';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page: PageKey;
  structuredData?: object;
  metadata?: { title: string; description: string };
  canonicalPath?: string;
  alternatePaths?: Record<Locale, string>;
  socialImagePath?: string;
  socialImageAlt?: string;
  documentType?: 'website' | 'article';
}

const {
  locale,
  page,
  structuredData,
  metadata: metadataOverride,
  canonicalPath: canonicalPathOverride,
  alternatePaths,
  socialImagePath = '/og/frekuence-club.jpg',
  socialImageAlt = 'Frekuence Club — Human Hz',
  documentType = 'website',
} = Astro.props;
const copy = t(locale);
const canonicalPath = canonicalPathOverride ?? routeFor(page, locale);
const canonicalUrl = new URL(canonicalPath, SITE.url).toString();
const sqPath = alternatePaths?.sq ?? routeFor(page, 'sq');
const enPath = alternatePaths?.en ?? routeFor(page, 'en');
const sqUrl = new URL(sqPath, SITE.url).toString();
const enUrl = new URL(enPath, SITE.url).toString();
const metadata = metadataOverride ?? copy.seo[page];
const ogImage = new URL(socialImagePath, SITE.url).toString();
const isNoIndex = import.meta.env.PUBLIC_NOINDEX === 'true';
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : null;
---

<!doctype html>
<html lang={copy.documentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    {isNoIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="sq-AL" href={sqUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={sqUrl} />

    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {
      socialImagePath === '/og/frekuence-club.jpg' && (
        <meta property="og:image:width" content="1200" />
      )
    }
    {
      socialImagePath === '/og/frekuence-club.jpg' && (
        <meta property="og:image:height" content="630" />
      )
    }
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={locale === 'sq' ? 'sq_AL' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'sq' ? 'en_GB' : 'sq_AL'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={documentType} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/png" href="/favicons/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={montserratUrl} as="font" type="font/woff2" crossorigin="anonymous" />

    {
      structuredDataJson && (
        <script type="application/ld+json" set:html={structuredDataJson} is:inline />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.global.skip}</a>
    <SiteHeader locale={locale} page={page} alternateHref={locale === 'sq' ? enPath : sqPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} page={page} />
  </body>
</html>
