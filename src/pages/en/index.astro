---
import { loadPublishedEvents } from '../../lib/events-api.server';
import EventServiceUnavailableView from '../../views/EventServiceUnavailableView.astro';
import HomeView from '../../views/HomeView.astro';

export const prerender = false;

let events;
try {
  events = await loadPublishedEvents('en');
} catch {
  Astro.response.status = 503;
}
---

{
  events ? (
    <HomeView locale="en" events={events} />
  ) : (
    <EventServiceUnavailableView locale="en" page="home" />
  )
}
