---
import EventDeck from '../components/EventDeck.astro';
import NextSignal from '../components/NextSignal.astro';
import SignalDivider from '../components/SignalDivider.astro';
import { type PublicEvent, selectHomepageEvents } from '../data/events';
import { t } from '../data/i18n';
import type { Locale } from '../data/routes';
import { venueStructuredData } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  events: PublicEvent[];
}

const { locale, events } = Astro.props;
const copy = t(locale);
const selection = selectHomepageEvents(events);
---

<BaseLayout locale={locale} page="home" structuredData={venueStructuredData}>
  <NextSignal
    locale={locale}
    event={selection.primary}
    hasPublishedEvents={selection.hasPublishedEvents}
  />
  <SignalDivider marker={copy.home.dividerMarker} />
  <EventDeck locale={locale} events={selection.deck} kind={selection.deckKind} />
</BaseLayout>
