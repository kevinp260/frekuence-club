# Development placeholders only. Generate unique production values and inject them at runtime.
FREKUENCE_WEB_PORT=3010
FREKUENCE_WEB_TAG=local
FREKUENCE_BACKEND_TAG=local
FREKUENCE_HOST_UID=1000
FREKUENCE_HOST_GID=1000

# Server-only Astro runtime settings. The API origin must never use a PUBLIC_* name.
FREKUENCE_EVENT_API_ORIGIN=http://backend:8000
FREKUENCE_EVENT_API_TIMEOUT_MS=2000

POSTGRES_DB=frekuence
POSTGRES_USER=frekuence
POSTGRES_PASSWORD=replace-with-a-random-database-password

DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# Optional and development-only. Do not reuse these placeholder values.
FREKUENCE_DEV_ADMIN_USERNAME=development-fixture-admin
FREKUENCE_DEV_ADMIN_PASSWORD=replace-with-a-unique-development-password
FREKUENCE_DEV_TOTP_KEY=replace-with-exactly-40-random-hex-characters
