---
import { Menu, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import symbol from '../assets/brand/temporary/frekuence-symbol-white.png';
import { t } from '../data/i18n';
import { alternateLocale, routeFor, type Locale, type PageKey } from '../data/routes';
import navigationScript from '../scripts/navigation.js?url';

interface Props {
  locale: Locale;
  page: PageKey;
  alternateHref?: string;
}

type DialDestination = {
  key: 'events' | 'about' | 'policy' | 'visit';
  label: string;
  href: string;
  active: boolean;
};

const { locale, page, alternateHref } = Astro.props;
const copy = t(locale);
const alternate = alternateLocale(locale);
const navPages = ['events', 'about', 'policy', 'visit'] as const;
const languageLabel = 'SQ / EN';
const frequencyTicks = ['outer-start', 'inner-start', 'inner-end', 'outer-end'] as const;
const terminusTicks = ['edge', 'inner'] as const;
const destinations: DialDestination[] = navPages.map((navPage) => ({
  key: navPage,
  label: copy.global.nav[navPage],
  href: routeFor(navPage, locale),
  active: page === navPage,
}));
const languageHref = alternateHref ?? routeFor(page, alternate);
const languageAccessibleLabel = `${languageLabel} — ${copy.global.languageSwitch}`;
const alternateDocumentLang = t(alternate).documentLang;
const activeDestinationIndex = destinations.findIndex((destination) => destination.active);
const hasCompactFrequency = page !== 'home';
---

<header class="site-header" data-site-header>
  <div class="header-frame">
    <a
      class="brand-link"
      href={routeFor('home', locale)}
      aria-label="Frekuence Club"
      aria-current={page === 'home' ? 'page' : undefined}
    >
      <Image src={symbol} width={80} height={80} alt="" loading="eager" />
      <span class="brand-wordmark">Frekuence Club</span>
    </a>

    <div
      class:list={['compact-frequency', { 'compact-frequency--active': hasCompactFrequency }]}
      aria-hidden="true"
      data-compact-frequency
    >
      <span class="compact-frequency__scale">
        <span class="frequency-terminus frequency-terminus--start">
          {
            terminusTicks.map((tick) => (
              <span class={`frequency-terminus__tick frequency-terminus__tick--${tick}`} />
            ))
          }
        </span>
        <span class="frequency-segment frequency-segment--compact">
          {frequencyTicks.map((tick) => <span class={`frequency-tick frequency-tick--${tick}`} />)}
          <span class="compact-frequency__station frequency-marker"></span>
        </span>
        <span class="frequency-terminus frequency-terminus--end">
          {
            terminusTicks.map((tick) => (
              <span class={`frequency-terminus__tick frequency-terminus__tick--${tick}`} />
            ))
          }
        </span>
      </span>
      {hasCompactFrequency && <span class="compact-frequency__label">7.83 Hz</span>}
    </div>

    <button
      class="nav-toggle"
      type="button"
      hidden
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label={copy.global.openMenu}
      data-open-label={copy.global.openMenu}
      data-close-label={copy.global.closeMenu}
    >
      <Menu class="nav-toggle__icon nav-toggle__menu" size={27} stroke-width={1.7} />
      <X class="nav-toggle__icon nav-toggle__close" size={27} stroke-width={1.7} />
    </button>

    <div
      id="primary-navigation"
      class="navigation-shell"
      data-navigation-shell
      aria-label={copy.global.navigation}
    >
      <div class="overlay-header">
        <a class="overlay-brand" href={routeFor('home', locale)} aria-label="Frekuence Club">
          <Image src={symbol} width={64} height={64} alt="" loading="eager" />
          <span>Frekuence Club</span>
        </a>
        <button
          class="nav-close"
          type="button"
          aria-label={copy.global.closeMenu}
          data-navigation-close
        >
          <X size={28} stroke-width={1.7} />
        </button>
      </div>

      <nav class="dial-navigation" aria-label={copy.global.navigation}>
        <span class="dial-terminus dial-terminus--start" aria-hidden="true">
          <span class="frequency-terminus frequency-terminus--start">
            {
              terminusTicks.map((tick) => (
                <span class={`frequency-terminus__tick frequency-terminus__tick--${tick}`} />
              ))
            }
          </span>
        </span>
        <div class="dial-stations">
          <ul>
            {
              destinations.map((destination) => (
                <li
                  class:list={['dial-station', { 'dial-station--active': destination.active }]}
                  data-dial-station={destination.key}
                >
                  <a
                    class="dial-link"
                    href={destination.href}
                    aria-current={destination.active ? 'page' : undefined}
                    data-navigation-link
                  >
                    <span class="dial-frequency" aria-hidden="true">
                      {destination.active ? '7.83 Hz' : ''}
                    </span>
                    <span class="frequency-segment frequency-segment--station" aria-hidden="true">
                      {frequencyTicks.map((tick) => (
                        <span class={`frequency-tick frequency-tick--${tick}`} />
                      ))}
                      <span class="dial-marker frequency-marker" />
                    </span>
                    <span class="dial-label">{destination.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <span
            class:list={[
              'dial-cursor',
              activeDestinationIndex >= 0
                ? `dial-cursor--station-${activeDestinationIndex}`
                : 'dial-cursor--origin',
              { 'dial-cursor--visible': activeDestinationIndex >= 0 },
            ]}
            data-dial-cursor
            aria-hidden="true"></span>
        </div>
        <span class="dial-terminus dial-terminus--end" aria-hidden="true">
          <span class="frequency-terminus frequency-terminus--end">
            {
              terminusTicks.map((tick) => (
                <span class={`frequency-terminus__tick frequency-terminus__tick--${tick}`} />
              ))
            }
          </span>
        </span>
      </nav>

      <a
        class="language-switch"
        href={languageHref}
        aria-label={languageAccessibleLabel}
        lang={alternateDocumentLang}
        hreflang={alternateDocumentLang}
        data-language-switch
        data-navigation-link
      >
        <span class="language-switch__control" aria-hidden="true">
          <span class:list={['language-switch__option', { 'is-selected': locale === 'sq' }]}
            >SQ</span
          >
          <span class:list={['language-switch__option', { 'is-selected': locale === 'en' }]}
            >EN</span
          >
        </span>
      </a>

      <p class="overlay-context">{copy.global.address}</p>
    </div>
  </div>
</header>

<script src={navigationScript} nonce={Astro.locals.cspNonce} is:inline></script>

<style>
  .site-header {
    position: sticky;
    z-index: 80;
    top: 0;
    background: var(--color-black);
  }

  .header-frame {
    display: grid;
    grid-template-columns: clamp(15.5rem, 22vw, 19rem) minmax(0, 1fr);
    align-items: stretch;
    min-height: var(--header-height);
    background: var(--color-black);
  }

  .brand-link,
  .overlay-brand {
    display: flex;
    align-items: center;
    color: var(--color-white);
    font-weight: 750;
    letter-spacing: 0.18em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-link {
    gap: clamp(0.7rem, 1.4vw, 1.2rem);
    min-width: 0;
    min-height: var(--header-height);
    padding-inline: clamp(0.8rem, 2vw, 1.5rem);
    border-right: 1px solid var(--color-gray-dark);
  }

  .brand-link:hover,
  .brand-link[aria-current='page'] {
    color: var(--color-white);
  }

  .brand-link img {
    flex: 0 0 auto;
    width: clamp(2.7rem, 4.5vw, 3.5rem);
    height: clamp(2.7rem, 4.5vw, 3.5rem);
  }

  .brand-wordmark {
    overflow: hidden;
    font-size: clamp(0.64rem, 0.85vw, 0.78rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .navigation-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(7.25rem, 9vw, 8.5rem);
    min-width: 0;
  }

  .navigation-shell[hidden] {
    display: none;
  }

  .dial-navigation {
    position: relative;
    display: grid;
    grid-template-columns: 3fr minmax(0, 30fr) 3fr;
    height: 100%;
    min-height: var(--header-height);
    overflow: hidden;
  }

  .language-switch {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: var(--header-height);
    padding: 0.75rem;
    border-left: 1px solid var(--color-gray-dark);
    color: var(--color-white);
    text-decoration: none;
  }

  .language-switch__control {
    display: grid;
    grid-template-columns: repeat(2, minmax(2.5rem, 1fr));
    min-width: 5.5rem;
    overflow: hidden;
    border: 1px solid var(--color-slate-light);
    border-radius: 999px;
    background: var(--color-black);
    transition: border-color 180ms ease;
  }

  .language-switch__option {
    display: grid;
    place-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.45rem;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .language-switch__option + .language-switch__option {
    border-left: 1px solid var(--color-slate-light);
  }

  .language-switch__option.is-selected {
    background: var(--color-white);
    color: var(--color-black);
  }

  .language-switch:hover .language-switch__control {
    border-color: var(--color-white);
  }

  .language-switch:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: -0.45rem;
  }

  .frequency-segment {
    position: relative;
    display: block;
    width: 100%;
    height: 1.6rem;
    pointer-events: none;
  }

  .frequency-segment::before,
  .frequency-segment::after {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 1.125rem;
    border-radius: 999px;
    background: var(--color-white);
    content: '';
    opacity: 0.86;
    transform: translate(-50%, -50%);
  }

  .frequency-segment::before {
    left: 0;
  }

  .frequency-segment::after {
    left: 100%;
  }

  .frequency-tick {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-slate-light);
    opacity: 0.78;
    transform: translate(-50%, -50%);
  }

  .frequency-tick--outer-start {
    left: calc(100% / 6);
  }

  .frequency-tick--inner-start {
    left: calc(100% / 3);
  }

  .frequency-tick--inner-end {
    left: calc(200% / 3);
  }

  .frequency-tick--outer-end {
    left: calc(500% / 6);
  }

  .frequency-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .frequency-terminus {
    position: relative;
    display: block;
    width: 100%;
    height: 1.6rem;
    pointer-events: none;
  }

  .frequency-terminus__tick {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-slate-light);
    opacity: 0.78;
    transform: translate(-50%, -50%);
  }

  .frequency-terminus--start .frequency-terminus__tick--edge,
  .frequency-terminus--end .frequency-terminus__tick--inner {
    left: calc(100% / 3);
  }

  .frequency-terminus--start .frequency-terminus__tick--inner,
  .frequency-terminus--end .frequency-terminus__tick--edge {
    left: calc(200% / 3);
  }

  .frequency-terminus__tick--edge {
    opacity: 0.34;
  }

  .dial-terminus {
    display: grid;
    grid-template-rows: 1.6rem 1.6rem minmax(2.2rem, auto);
    align-content: center;
    min-height: var(--header-height);
    padding: 0.65rem 0 0.45rem;
  }

  .dial-terminus--start {
    grid-column: 1;
  }

  .dial-terminus--end {
    grid-column: 3;
  }

  .dial-terminus .frequency-terminus {
    grid-row: 2;
  }

  .dial-stations {
    position: relative;
    grid-column: 2;
    min-width: 0;
    height: 100%;
  }

  .dial-navigation ul {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dial-cursor {
    --dial-cursor-position: -4.166667%;
    position: absolute;
    z-index: 3;
    top: calc(50% - 0.2rem);
    left: var(--dial-cursor-position);
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-signal-red);
    border-radius: 50%;
    background: var(--color-signal-red);
    box-shadow:
      0 0 0 3px var(--color-black),
      0 0 0 5px var(--color-signal-red),
      0 0 0.7rem rgb(255 1 1 / 38%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition:
      left 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
      top 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 80ms linear,
      border-color 120ms ease,
      background-color 120ms ease,
      box-shadow 120ms ease;
  }

  .dial-cursor--visible {
    opacity: 1;
  }

  .dial-cursor--resetting {
    transition: none;
  }

  .dial-cursor--station-0 {
    --dial-cursor-position: 12.5%;
  }

  .dial-cursor--station-1 {
    --dial-cursor-position: 37.5%;
  }

  .dial-cursor--station-2 {
    --dial-cursor-position: 62.5%;
  }

  .dial-cursor--station-3 {
    --dial-cursor-position: 87.5%;
  }

  .dial-station {
    min-width: 0;
  }

  .dial-link {
    display: grid;
    grid-template-rows: 1.6rem 1.6rem minmax(2.2rem, auto);
    align-content: center;
    justify-items: center;
    width: 100%;
    min-width: 2.75rem;
    min-height: var(--header-height);
    padding: 0.65rem 0 0.45rem;
    color: var(--color-white);
    text-align: center;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .dial-frequency {
    align-self: end;
    min-height: 1em;
    color: var(--color-signal-red);
    font-size: clamp(0.58rem, 0.72vw, 0.7rem);
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dial-marker {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-black);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .dial-label {
    align-self: start;
    max-width: 100%;
    padding: 0.28rem 0.3rem 0;
    font-size: clamp(0.61rem, 0.78vw, 0.78rem);
    font-weight: 750;
    letter-spacing: clamp(0.06em, 0.12vw, 0.13em);
    line-height: 1.18;
    text-transform: uppercase;
  }

  .dial-link:hover .dial-marker {
    background: var(--color-white);
    transform: translate(-50%, -50%) scale(1.08);
  }

  .dial-link:focus-visible {
    z-index: 2;
    outline: none;
  }

  .dial-link:focus-visible .dial-marker {
    box-shadow:
      0 0 0 3px var(--color-black),
      0 0 0 6px var(--color-white);
  }

  .dial-link:focus-visible .dial-label {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.32em;
  }

  .dial-station--active .dial-link,
  .dial-station--active .dial-link:hover {
    color: var(--color-signal-red);
  }

  .dial-station--active .dial-marker,
  .dial-station--active .dial-link:hover .dial-marker {
    border-color: var(--color-white);
    background: var(--color-black);
    box-shadow: none;
    transform: translate(-50%, -50%);
  }

  .dial-station--active .dial-link:focus-visible .dial-marker {
    box-shadow:
      0 0 0 3px var(--color-black),
      0 0 0 6px var(--color-white);
  }

  .dial-navigation[data-tuning] .dial-station--active .dial-link {
    color: var(--color-white);
  }

  .dial-navigation[data-tuning] .dial-station--active .dial-frequency {
    opacity: 0.36;
  }

  .dial-navigation[data-tuning] .dial-station--tuning-target .dial-link {
    color: var(--color-signal-red);
  }

  .overlay-header,
  .overlay-context,
  .compact-frequency,
  .nav-toggle {
    display: none;
  }

  @media (max-width: 63.999rem) {
    .site-header:not([data-enhanced]) {
      position: relative;
    }

    .header-frame {
      grid-template-columns: 4.75rem minmax(0, 1fr) 4.75rem;
      min-height: var(--header-height);
    }

    .brand-link {
      justify-content: center;
      min-height: var(--header-height);
      padding: 0;
    }

    .brand-link img {
      width: 2.65rem;
      height: 2.65rem;
    }

    .brand-wordmark {
      display: none;
    }

    .compact-frequency {
      position: relative;
      display: grid;
      place-items: center;
      min-width: 0;
      min-height: var(--header-height);
      overflow: hidden;
    }

    .compact-frequency__scale {
      position: absolute;
      top: 1.24rem;
      right: clamp(0.45rem, 3vw, 1.5rem);
      left: clamp(0.45rem, 3vw, 1.5rem);
      display: grid;
      grid-template-columns: 3fr 6fr 3fr;
      height: 1.6rem;
    }

    .compact-frequency__station {
      z-index: 1;
      width: 1.05rem;
      height: 1.05rem;
      border: 2px solid var(--color-white);
      border-radius: 50%;
      background: var(--color-black);
    }

    .compact-frequency__label {
      position: absolute;
      top: 3.18rem;
      left: 50%;
      color: var(--color-signal-red);
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      line-height: 1;
      text-transform: uppercase;
      transform: translateX(-50%);
      white-space: nowrap;
    }

    .compact-frequency--active .compact-frequency__station {
      border-color: var(--color-signal-red);
      background: var(--color-signal-red);
      box-shadow:
        0 0 0 3px var(--color-black),
        0 0 0 5px var(--color-signal-red),
        0 0 0.55rem rgb(255 1 1 / 32%);
    }

    .site-header[data-enhanced] .nav-toggle {
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      min-width: 2.75rem;
      min-height: var(--header-height);
      padding: 0;
      border: 0;
      border-left: 1px solid var(--color-gray-dark);
      border-radius: 0;
      background: transparent;
      color: var(--color-white);
      cursor: pointer;
    }

    .nav-toggle :global(.nav-toggle__icon) {
      position: absolute;
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }

    .nav-toggle :global(.nav-toggle__close) {
      opacity: 0;
      transform: rotate(-90deg) scale(0.82);
    }

    .nav-toggle[aria-expanded='true'] :global(.nav-toggle__menu) {
      opacity: 0;
      transform: rotate(90deg) scale(0.82);
    }

    .nav-toggle[aria-expanded='true'] :global(.nav-toggle__close) {
      opacity: 1;
      transform: none;
    }

    .navigation-shell {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
      min-height: 27rem;
      background: var(--color-black);
    }

    .site-header[data-enhanced] .navigation-shell:not([hidden]) {
      position: fixed;
      z-index: 140;
      inset: 0;
      display: grid;
      grid-template-rows: auto minmax(23rem, 1fr) auto auto;
      grid-template-columns: 1fr;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      min-height: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      border: 0;
      background: var(--color-black);
    }

    .site-header[data-enhanced] .overlay-header {
      position: sticky;
      z-index: 3;
      top: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: calc(4.75rem + env(safe-area-inset-top));
      padding: env(safe-area-inset-top) max(1rem, env(safe-area-inset-right)) 0
        max(1rem, env(safe-area-inset-left));
      background: var(--color-black);
    }

    .overlay-brand {
      gap: 0.75rem;
      min-height: 2.75rem;
      font-size: clamp(0.63rem, 2.8vw, 0.76rem);
    }

    .overlay-brand:hover {
      color: var(--color-white);
    }

    .overlay-brand img {
      width: 2.45rem;
      height: 2.45rem;
    }

    .nav-close {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 1px solid var(--color-gray-dark);
      border-radius: 50%;
      background: var(--color-black);
      color: var(--color-white);
      cursor: pointer;
    }

    .dial-navigation {
      --dial-x: clamp(2.8rem, 17vw, 5.25rem);
      display: grid;
      grid-template-rows: 3fr minmax(19rem, 24fr) 3fr;
      grid-template-columns: 1fr;
      height: auto;
      min-height: 23.75rem;
      overflow: visible;
      padding: clamp(1rem, 3vh, 2rem) max(1rem, env(safe-area-inset-right)) clamp(1rem, 3vh, 2rem)
        max(1rem, env(safe-area-inset-left));
    }

    .dial-navigation ul {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, minmax(4.75rem, 1fr));
      min-height: 100%;
    }

    .dial-stations {
      grid-row: 2;
      grid-column: 1;
      width: 100%;
      min-height: 19rem;
    }

    .dial-cursor {
      top: var(--dial-cursor-position);
      left: var(--dial-x);
      width: 1.15rem;
      height: 1.15rem;
    }

    .dial-link {
      position: relative;
      grid-template-rows: auto;
      grid-template-columns: calc(var(--dial-x) * 2) minmax(0, 1fr);
      align-content: center;
      justify-items: start;
      height: 100%;
      min-height: 4.75rem;
      padding: 0 0.25rem;
      text-align: left;
    }

    .frequency-segment--station {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: calc(var(--dial-x) * 2);
      height: auto;
    }

    .frequency-segment--station::before,
    .frequency-segment--station::after {
      left: 50%;
      width: 1.125rem;
      height: 2px;
    }

    .frequency-segment--station::before {
      top: 0;
    }

    .frequency-segment--station::after {
      top: 100%;
    }

    .frequency-segment--station .frequency-tick {
      left: 50%;
      width: 0.5rem;
      height: 2px;
    }

