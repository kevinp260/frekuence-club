---
import EventPoster from '../components/EventPoster.astro';
import SignalLink from '../components/SignalLink.astro';
import type { PublicEvent } from '../data/events';
import { eventRoute, formatEventDate, formatEventTime } from '../data/events';
import { t } from '../data/i18n';
import { routeFor, type Locale } from '../data/routes';
import { SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  event: PublicEvent;
}

const { locale, event } = Astro.props;
const copy = t(locale);
const canonicalPath = eventRoute(event.slug, locale);
const alternatePaths = {
  sq: eventRoute(event.slug, 'sq'),
  en: eventRoute(event.slug, 'en'),
};
const metadata = {
  title: `${event.title} — Frekuence Club`,
  description: event.summary,
};
const socialImage = event.poster.social?.url ?? event.poster.sources.at(-1)?.url;
const eventStatusUrls = {
  scheduled: 'https://schema.org/EventScheduled',
  postponed: 'https://schema.org/EventPostponed',
  cancelled: 'https://schema.org/EventCancelled',
} as const;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: event.title,
  description: event.summary,
  startDate: event.startsAt.toISOString(),
  endDate: event.endsAt.toISOString(),
  eventStatus: eventStatusUrls[event.status],
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  ...(socialImage ? { image: new URL(socialImage, SITE.url).toString() } : {}),
  location: {
    '@type': 'Place',
    name: SITE.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.venue,
      addressLocality: SITE.address.locality,
      addressCountry: SITE.address.countryCode,
    },
  },
};
---

<BaseLayout
  locale={locale}
  page="events"
  metadata={metadata}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  socialImagePath={socialImage ?? '/og/frekuence-club.jpg'}
  socialImageAlt={event.poster.alt}
  documentType="article"
  structuredData={structuredData}
>
  <article class="event-detail section-shell">
    <header class="event-detail__header">
      <div class="event-detail__title">
        <p class="kicker">{copy.events.detailsKicker}</p>
        <p class="event-detail__status">{copy.events.statusLabels[event.status]}</p>
        <h1>{event.title}</h1>
        <p class="event-detail__summary">{event.summary}</p>
      </div>
      <div class="event-detail__poster">
        <EventPoster
          poster={event.poster}
          locale={locale}
          sizes="(max-width: 48rem) 100vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </header>

    <div class="event-detail__body">
      <dl class="event-detail__schedule">
        <div>
          <dt>{copy.events.startsLabel}</dt>
          <dd>
            <time datetime={event.startsAt.toISOString()}>
              {formatEventDate(event.startsAt, locale)}
            </time>
          </dd>
        </div>
        <div>
          <dt>{copy.events.endsLabel}</dt>
          <dd>
            <time datetime={event.endsAt.toISOString()}>
              {formatEventDate(event.endsAt, locale)}
            </time>
          </dd>
        </div>
        {
          event.doorsAt && (
            <div>
              <dt>{copy.events.doorsLabel}</dt>
              <dd>
                <time datetime={event.doorsAt.toISOString()}>
                  {formatEventTime(event.doorsAt, locale)}
                </time>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="event-detail__editorial">
        <p>{event.description}</p>
        {event.entryNote && <p>{event.entryNote}</p>}
        {
          event.lineup.length > 0 && (
            <section aria-labelledby="event-lineup-title">
              <h2 id="event-lineup-title">{copy.events.lineupLabel}</h2>
              <ol>
                {event.lineup.map((artist) => (
                  <li>{artist}</li>
                ))}
              </ol>
            </section>
          )
        }
        <div class="event-detail__context">
          <p>{copy.home.ageContext}</p>
          <p>{copy.home.doorContext}</p>
          <p>{copy.common.noMedia}</p>
        </div>
        <div class="event-detail__actions">
          <SignalLink href={routeFor('events', locale)}>{copy.common.backToEvents}</SignalLink>
          <SignalLink href={SITE.maps} external>{copy.common.directions}</SignalLink>
          <SignalLink href={SITE.instagram} external>{copy.common.instagram}</SignalLink>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .event-detail {
    padding-block: var(--space-5) var(--space-7);
  }

  .event-detail__header {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: end;
    gap: var(--space-6);
    min-height: calc(100svh - var(--header-height) - var(--space-5));
    padding-bottom: var(--space-6);
  }

  .event-detail__status {
    margin: var(--space-3) 0 0;
    color: var(--color-signal-red);
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-detail h1 {
    max-width: 12ch;
    margin-block: var(--space-3) 0;
    font-size: var(--step-5);
    line-height: 0.84;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .event-detail__summary {
    max-width: 42rem;
    margin-block: var(--space-4) 0;
    color: var(--color-soft-linen);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .event-detail__poster {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-signal-cyan);
    box-shadow:
      -0.7rem 0.7rem 0 -1px var(--color-black),
      -0.7rem 0.7rem 0 var(--color-signal-magenta);
  }

  .event-detail__body {
    display: grid;
    grid-template-columns: minmax(14rem, 0.55fr) minmax(0, 1.45fr);
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-dark);
  }

  .event-detail__schedule {
    margin: 0;
  }

  .event-detail__schedule > div {
    padding-block: 1rem;
    border-top: 1px solid var(--color-gray-dark);
  }

  .event-detail__schedule dt {
    color: var(--color-signal-red);
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-detail__schedule dd {
    margin: 0.35rem 0 0;
    font-weight: 700;
  }

  .event-detail__editorial {
    max-width: 52rem;
  }

  .event-detail__editorial > p {
    margin-block: 0 var(--space-4);
    font-size: var(--step-1);
  }

  .event-detail__editorial h2 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-3);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .event-detail__editorial ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-gray-dark);
    list-style: none;
  }

  .event-detail__editorial li {
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-gray-dark);
    color: var(--color-signal-cyan);
    font-weight: 750;
    text-transform: uppercase;
  }

  .event-detail__context {
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-gray-dark);
  }

  .event-detail__context p {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
  }

  .event-detail__context p + p {
    margin-top: 0.6rem;
  }

  .event-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--space-5);
  }

  @media (max-width: 47.99rem) {
    .event-detail__header,
    .event-detail__body {
      grid-template-columns: 1fr;
    }

    .event-detail__header {
      min-height: 0;
    }

    .event-detail__title {
      order: 2;
    }

    .event-detail__poster {
      width: min(82vw, 22rem);
      justify-self: center;
    }

    .event-detail__actions :global(.signal-link) {
      width: 100%;
    }
  }
</style>
