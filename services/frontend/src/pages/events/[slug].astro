---
import { EventApiNotFoundError, loadPublishedEvent } from '../../lib/events-api.server';
import type { PublicEvent } from '../../data/events';
import EventDetailView from '../../views/EventDetailView.astro';
import EventNotFoundView from '../../views/EventNotFoundView.astro';
import EventServiceUnavailableView from '../../views/EventServiceUnavailableView.astro';

export const prerender = false;

let event: PublicEvent | undefined;
let state: 'found' | 'not-found' | 'unavailable' = 'found';
try {
  event = await loadPublishedEvent('sq', Astro.params.slug ?? '');
} catch (error) {
  if (error instanceof EventApiNotFoundError) {
    Astro.response.status = 404;
    state = 'not-found';
  } else {
    Astro.response.status = 503;
    state = 'unavailable';
  }
}
---

{
  state === 'found' && event ? (
    <EventDetailView locale="sq" event={event} />
  ) : state === 'not-found' ? (
    <EventNotFoundView locale="sq" />
  ) : (
    <EventServiceUnavailableView locale="sq" page="events" />
  )
}
