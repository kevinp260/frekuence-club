FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e AS browser-dependencies

WORKDIR /review

COPY package.json package-lock.json .npmrc ./
RUN npm ci && chown -R pwuser:pwuser /review

FROM browser-dependencies AS staff-visual

COPY scripts/capture-staff-review.mjs ./capture-staff-review.mjs

USER pwuser

CMD ["node", "capture-staff-review.mjs"]

FROM browser-dependencies AS frontend-check

ENV CHROME_PATH=/ms-playwright/chromium-1234/chrome-linux64/chrome

COPY --chown=pwuser:pwuser . .

USER pwuser

CMD ["sh", "-c", "npm run build && npm run test:e2e"]
