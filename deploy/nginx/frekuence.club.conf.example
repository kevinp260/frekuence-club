# HTTP bootstrap configuration for Certbot. Review the loopback port and the
# host's existing default-server policy before installing it. After this site
# is reachable over HTTP, run:
#
#   sudo certbot --nginx -d frekuence.club --redirect
#
# Certbot will add the certificate paths, HTTPS listener, and HTTP redirect.

server {
    listen 80;
    listen [::]:80;
    server_name frekuence.club;

    # Allow the gateway's bounded staff-upload route; the gateway applies a
    # smaller 1 MiB default everywhere else and Django enforces 25 MiB/file.
    client_max_body_size 26m;
    client_body_timeout 15s;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-CSP-Nonce "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;
        proxy_redirect off;
    }
}
